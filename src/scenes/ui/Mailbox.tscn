[gd_scene format=3]

[ext_resource type="Script" path="res://src/scenes/ui/Mailbox.gd" id="1"]

[node name="Mailbox" type="CanvasLayer"]
layer = 10
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
custom_minimum_size = Vector2(620, 0)
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
text = "Harbor Mailbox"
theme_override_font_sizes/font_size = 28

[node name="RecipientsLabel" type="Label" parent="Center/Panel/Margin/VBox"]
text = "Recipients"

[node name="RecipientSearch" type="LineEdit" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
placeholder_text = "Type a player name to add a recipient"
tooltip_text = "Type to search players who have logged in."

[node name="RecipientMatches" type="VBoxContainer" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true

[node name="RecipientSummary" type="Label" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
text = "No recipients selected."
autowrap_mode = 3

[node name="Message" type="TextEdit" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
placeholder_text = "Write a letter"
custom_minimum_size = Vector2(0, 72)

[node name="AttachCoinsLabel" type="Label" parent="Center/Panel/Margin/VBox"]
text = "Attach coins to each recipient"

[node name="CoinAmount" type="SpinBox" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
min_value = 0.0
max_value = 999999.0
tooltip_text = "This amount is attached to each recipient’s copy."

[node name="Send" type="Button" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
text = "Send Letter"

[node name="Status" type="Label" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
horizontal_alignment = 1

[node name="Sep" type="HSeparator" parent="Center/Panel/Margin/VBox"]

[node name="InboxTitle" type="Label" parent="Center/Panel/Margin/VBox"]
text = "Inbox"

[node name="Refresh" type="Button" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
text = "Refresh Inbox"

[node name="Sort" type="Button" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
text = "Unread First"

[node name="Scroll" type="ScrollContainer" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 180)

[node name="Inbox" type="VBoxContainer" parent="Center/Panel/Margin/VBox/Scroll"]
unique_name_in_owner = true
size_flags_horizontal = 3

[node name="LetterPreview" type="RichTextLabel" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 90)
bbcode_enabled = true
fit_content = true

[node name="Actions" type="HBoxContainer" parent="Center/Panel/Margin/VBox"]
visible = false

[node name="Reply" type="Button" parent="Center/Panel/Margin/VBox/Actions"]
unique_name_in_owner = true
text = "Reply"

[node name="ReplyAll" type="Button" parent="Center/Panel/Margin/VBox/Actions"]
unique_name_in_owner = true
text = "Reply All"

[node name="Forward" type="Button" parent="Center/Panel/Margin/VBox/Actions"]
unique_name_in_owner = true
text = "Forward"

[node name="Claim" type="Button" parent="Center/Panel/Margin/VBox/Actions"]
unique_name_in_owner = true
text = "Claim Coins"
disabled = true

[node name="Delete" type="Button" parent="Center/Panel/Margin/VBox/Actions"]
unique_name_in_owner = true
text = "Delete"

[node name="Close" type="Button" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
text = "Close  [Esc]"
